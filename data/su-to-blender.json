{
  "workflows": [
    {
      "id": "wflow-001",
      "name": "效果图工作流",
      "nameEn": "Render Workflow",
      "description": "从SketchUp模型到Blender效果图输出",
      "steps": [
        { "id": "step-01", "name": "SketchUp模型检查", "nameEn": "SU Model Check", "detail": "检查Group/Component命名、Tag清理、删除不可见几何体" },
        { "id": "step-02", "name": "Group整理", "nameEn": "Group Organization", "detail": "按墙体/门窗/家具/灯具分组" },
        { "id": "step-03", "name": "Tag整理", "nameEn": "Tag Management", "detail": "确保Tag干净，无多余图层" },
        { "id": "step-04", "name": "FBX导出", "nameEn": "FBX Export", "detail": "File → Export → FBX，单位Millimeters" },
        { "id": "step-05", "name": "Blender导入", "nameEn": "Blender Import", "detail": "File → Import → FBX" },
        { "id": "step-06", "name": "单位检查", "nameEn": "Unit Check", "detail": "Scene Properties → Units → Centimeters" },
        { "id": "step-07", "name": "Scale检查", "nameEn": "Scale Check", "detail": "Ctrl+A → All Transforms，确认Scale=1" },
        { "id": "step-08", "name": "Normal检查", "nameEn": "Normal Check", "detail": "Edit Mode → Shift+N → Recalculate Outside" },
        { "id": "step-09", "name": "模型整理", "nameEn": "Model Cleanup", "detail": "Merge by Distance, Collection组织" },
        { "id": "step-10", "name": "材质", "nameEn": "Materials", "detail": "创建/赋予室内材质" },
        { "id": "step-11", "name": "灯光", "nameEn": "Lighting", "detail": "Sun/HDRI + Area/Spot + Emission" },
        { "id": "step-12", "name": "Camera", "nameEn": "Camera", "detail": "设置焦距/高度/构图" },
        { "id": "step-13", "name": "Eevee测试", "nameEn": "Eevee Test", "detail": "快速预览效果图效果" },
        { "id": "step-14", "name": "Cycles最终渲染", "nameEn": "Cycles Final Render", "detail": "高采样+降噪，输出效果图" }
      ]
    },
